+// Wave 10: unified zero-copy GPU probabilistic rejection sampling fast path.
+// Supports both unconstrained generation AND active grammar / reasoning_budget (!grammar_first) with
+// 100% mathematically exact Leviathan et al. target distribution preservation:
+// - When !grammar_should_apply(gsmpl): pure zero-copy GPU p vs draft q (0 raw logits copy, 0 CPU softmax).
+// - When grammar_should_apply(gsmpl): since Z = sum_{valid} p <= 1 implies p'(x) = p(x)/Z >= p(x),
+//   a valid draft token with u < p(x)/q(x) is guaranteed to satisfy u < p'(x)/q(x) and accepts in O(1)
+//   without computing Z! Only when rejected or u >= p(x)/q(x) do we mask p_arr by grmr to compute exact Z,
+//   re-test with the SAME u, or sample exact norm(max(0, p' - q)) over grammar-valid tokens.
+template <typename QAccessor>
+static bool rejection_gpu_fastpath(
+        struct common_sampler * gsmpl,
+        struct llama_context * ctx,
+        const std::vector<int> & idxs,
+        const llama_tokens & draft,
+        const QAccessor & q_acc,
+        bool grammar_first,
+        std::vector<llama_token> & result) {
+    static const bool w10_no_gpu_prob_grmr = (getenv("W10_NO_GPU_PROB_GRMR") != nullptr);
+    if (draft.empty() || grammar_first) {
+        return false;
+    }
+    if (w10_no_gpu_prob_grmr && (gsmpl->grmr || gsmpl->rbudget)) {
+        return false;
+    }
+
+    llama_synchronize(ctx);
+    if (llama_get_sampled_token_ith(ctx, idxs[0]) == LLAMA_TOKEN_NULL ||
+            llama_get_sampled_probs_ith(ctx, idxs[0]) == nullptr) {
+        return false;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx));
+    std::uniform_real_distribution<float> uni(0.0f, 1.0f);
+
+    size_t i = 0;
+    for (; i < draft.size(); ++i) {
+        if (gsmpl->rbudget && common_reasoning_budget_get_state(gsmpl->rbudget) == REASONING_BUDGET_FORCING) {
+            const llama_token id = common_sampler_sample(gsmpl, ctx, idxs[i], grammar_first);
+            common_sampler_accept(gsmpl, id, true);
+            result.push_back(id);
+            break;
+        }
+
+        const llama_token id_tgt  = llama_get_sampled_token_ith(ctx, idxs[i]);
+        const float * p_arr       = llama_get_sampled_probs_ith(ctx, idxs[i]);
+        const uint32_t p_cnt      = llama_get_sampled_probs_count_ith(ctx, idxs[i]);
+        const llama_token * p_ids = llama_get_sampled_candidates_ith(ctx, idxs[i]);
+        const bool direct_ids     = (llama_get_sampled_candidates_count_ith(ctx, idxs[i]) == 0);
+
+        const float q_x = q_acc.prob(i, draft[i]);
+
+        float p_x = 0.0f;
+        if (direct_ids) {
+            if (draft[i] >= 0 && (uint32_t) draft[i] < p_cnt) {
+                p_x = p_arr[draft[i]];
+            }
+        } else {
+            for (uint32_t k = 0; k < p_cnt; ++k) {
+                if (p_ids[k] == draft[i]) {
+                    p_x = p_arr[k];
+                    break;
+                }
+            }
+        }
+
+        const bool use_grmr = grammar_should_apply(gsmpl);
+        if (!use_grmr) {
+            if (q_x > 0.0f && (p_x >= q_x || uni(gsmpl->rng) < p_x / q_x)) {
+                common_sampler_accept(gsmpl, draft[i], true);
+                result.push_back(draft[i]);
+                if (llama_vocab_is_eog(vocab, draft[i]) && i + 1 < draft.size()) {
+                    break;
+                }
+                continue;
+            }
+
+            // rejected (unconstrained): sample from norm(max(0, p - q)) in two zero-allocation passes
+            const float * q_flat = q_acc.flat_ptr(i, p_cnt);
+            float sum = 0.0f;
+            llama_token last_pos_id = id_tgt;
+            if (direct_ids && q_flat != nullptr) {
+                for (uint32_t k = 0; k < p_cnt; ++k) {
+                    const float r = p_arr[k] - q_flat[k];
+                    if (r > 0.0f) {
+                        sum += r;
+                        last_pos_id = (llama_token) k;
+                    }
+                }
+            } else if (direct_ids && q_acc.is_direct(i, p_cnt)) {
+                for (uint32_t k = 0; k < p_cnt; ++k) {
+                    const float r = p_arr[k] - q_acc.at(i, k);
+                    if (r > 0.0f) {
+                        sum += r;
+                        last_pos_id = (llama_token) k;
+                    }
+                }
+            } else {
+                for (uint32_t k = 0; k < p_cnt; ++k) {
+                    const llama_token tid = direct_ids ? (llama_token) k : p_ids[k];
+                    const float r = p_arr[k] - q_acc.prob(i, tid);
+                    if (r > 0.0f) {
+                        sum += r;
+                        last_pos_id = tid;
+                    }
+                }
+            }
+
+            llama_token id = id_tgt;
+            if (sum > 0.0f) {
+                float u = uni(gsmpl->rng) * sum;
+                id = last_pos_id;
+                if (direct_ids && q_flat != nullptr) {
+                    for (uint32_t k = 0; k < p_cnt; ++k) {
+                        const float r = p_arr[k] - q_flat[k];
+                        if (r > 0.0f) {
+                            u -= r;
+                            if (u <= 0.0f) {
+                                id = (llama_token) k;
+                                break;
+                            }
+                        }
+                    }
+                } else if (direct_ids && q_acc.is_direct(i, p_cnt)) {
+                    for (uint32_t k = 0; k < p_cnt; ++k) {
+                        const float r = p_arr[k] - q_acc.at(i, k);
+                        if (r > 0.0f) {
+                            u -= r;
+                            if (u <= 0.0f) {
+                                id = (llama_token) k;
+                                break;
+                            }
+                        }
+                    }
+                } else {
+                    for (uint32_t k = 0; k < p_cnt; ++k) {
+                        const llama_token tid = direct_ids ? (llama_token) k : p_ids[k];
+                        const float r = p_arr[k] - q_acc.prob(i, tid);
+                        if (r > 0.0f) {
+                            u -= r;
+                            if (u <= 0.0f) {
+                                id = tid;
+                                break;
+                            }
+                        }
+                    }
+                }
+            }
+
+            common_sampler_accept(gsmpl, id, true);
+            result.push_back(id);
+            break;
+        }
+
+        // Active grammar path: O(1) validity test on draft[i] + Exact Theorem Fast-Path
+        llama_token_data       sd  = { draft[i], 1.0f, 0.0f };
+        llama_token_data_array sda = { &sd, 1, -1, false };
+        llama_sampler_apply(gsmpl->grmr, &sda);
+        const bool draft_valid = (sd.logit != -INFINITY);
+
+        const float u = uni(gsmpl->rng);
+        if (draft_valid && q_x > 0.0f && (p_x >= q_x || u < p_x / q_x)) {
+            common_sampler_accept(gsmpl, draft[i], true);
+            result.push_back(draft[i]);
+            if (llama_vocab_is_eog(vocab, draft[i]) && i + 1 < draft.size()) {
+                break;
+            }
+            continue;
+        }
+
+        // Apply grammar mask to GPU target probabilities p_arr (reuses cand_grmr, 0 raw logits D2H).
+        // Skip exact zero-probability tokens (100% mathematically identical: 0 contributes 0 to Z and 0 to max(0, p'-q)).
+        auto & cand = gsmpl->cand_grmr;
+        cand.clear();
+        if (direct_ids) {
+            for (uint32_t k = 0; k < p_cnt; ++k) {
+                const float pk = p_arr[k];
+                if (pk > 0.0f) {
+                    cand.push_back({ (llama_token) k, 0.0f, pk });
+                }
+            }
+        } else {
+            for (uint32_t k = 0; k < p_cnt; ++k) {
+                const float pk = p_arr[k];
+                if (pk > 0.0f) {
+                    cand.push_back({ p_ids[k], 0.0f, pk });
+                }
+            }
+        }
+        llama_token_data_array carr = { cand.data(), cand.size(), -1, false };
+        if (!cand.empty()) {
+            llama_sampler_apply(gsmpl->grmr, &carr);
+        }
+
+        float p_sum = 0.0f;
+        for (size_t c = 0; c < cand.size(); ++c) {
+            if (cand[c].logit != -INFINITY) {
+                p_sum += cand[c].p;
+            }
+        }
+
+        if (p_sum <= 0.0f) {
+            // Sampler truncation pruned all grammar-valid tokens: exact raw-logits grammar-masked resample.
+            const llama_token id = common_sampler_sample(gsmpl, ctx, idxs[i], grammar_first);
+            common_sampler_accept(gsmpl, id, true);
+            result.push_back(id);
+            break;
+        }
+
+        const float inv_z = 1.0f / p_sum;
+        if (draft_valid && q_x > 0.0f && (p_x * inv_z >= q_x || u < (p_x * inv_z) / q_x)) {
+            common_sampler_accept(gsmpl, draft[i], true);
+            result.push_back(draft[i]);
+            if (llama_vocab_is_eog(vocab, draft[i]) && i + 1 < draft.size()) {
+                break;
+            }
+            continue;
+        }
+
+        const float * q_flat = q_acc.flat_ptr(i, p_cnt);
+        const bool q_direct  = (q_flat == nullptr && direct_ids && q_acc.is_direct(i, p_cnt));
+        float sum = 0.0f;
+        llama_token last_pos_id   = LLAMA_TOKEN_NULL;
+        llama_token best_valid_id = LLAMA_TOKEN_NULL;
+        float best_valid_p = -1.0f;
+        for (size_t c = 0; c < cand.size(); ++c) {
+            if (cand[c].logit == -INFINITY) {
+                continue;
+            }
