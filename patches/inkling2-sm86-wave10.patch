+using inkling_skipped_get_rows_map = std::unordered_map<const ggml_tensor *, std::pair<const ggml_tensor *, const int32_t *>>;
+
+static bool inkling_resolve_skipped_past(
+        const ggml_tensor * past,
+        const inkling_skipped_get_rows_map * skipped_gr,
+        const float *& past_ptr_out,
+        const int32_t *& row_idx_out,
+        size_t & row_stride_f_out) {
+    if (!skipped_gr || skipped_gr->empty() || !past) {
+        return false;
+    }
+    size_t offs = 0;
+    const ggml_tensor * t = past;
+    for (int hop = 0; hop < 8 && t != nullptr; ++hop) {
+        auto it = skipped_gr->find(t);
+        if (it != skipped_gr->end()) {
+            const ggml_tensor * state_src = it->second.first;
+            past_ptr_out     = (const float *) ((const char *) state_src->data + offs);
+            row_idx_out      = it->second.second;
+            row_stride_f_out = state_src->nb[1] / sizeof(float);
+            return true;
+        }
+        if (t->op == GGML_OP_VIEW) {
+            offs += t->view_offs;
+            t = t->view_src ? t->view_src : t->src[0];
+        } else if (t->op == GGML_OP_RESHAPE) {
+            t = t->src[0];
+        } else {
+            break;
+        }
+    }
+    return false;
+}
