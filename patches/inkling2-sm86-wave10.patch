+// Matches build_conv_state_store for BOTH n_rs_seq == 0 (3-node CPY) and n_rs_seq > 0 (7-node SET_ROWS rollback)!
+static bool inkling_match_conv_store(
+        const ggml_cgraph * cgraph,
+        const int store_pos,
+        const ggml_tensor * n_cat,
+        const int64_t T,
+        const int64_t C,
+        const int64_t n_seqs,
+        inkling_conv_store_match & out) {
+    if (store_pos + 2 < cgraph->n_nodes && cgraph->nodes[store_pos + 2]->op == GGML_OP_CPY) {
+        ggml_tensor * n_vl  = cgraph->nodes[store_pos + 0];
+        ggml_tensor * n_vc  = cgraph->nodes[store_pos + 1];
+        ggml_tensor * n_cpy = cgraph->nodes[store_pos + 2];
+        if (n_vl->op == GGML_OP_VIEW && n_vc->op == GGML_OP_VIEW &&
+                (n_vl->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 && (n_vl->flags & GGML_TENSOR_FLAG_OUTPUT) == 0 &&
+                (n_vc->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 && (n_vc->flags & GGML_TENSOR_FLAG_OUTPUT) == 0 &&
+                (n_cpy->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 &&
+                ggml_node_get_use_count(cgraph, store_pos + 0) == 1 &&
+                ggml_node_get_use_count(cgraph, store_pos + 1) == 1 &&
+                n_vl->src[0] == n_cat && n_vl->ne[0] == 3 && n_vl->ne[1] == C && n_vl->ne[2] == n_seqs &&
+                n_vl->view_offs == (size_t) T * sizeof(float) &&
+                n_cpy->src[0] == n_vl && n_cpy->src[1] == n_vc &&
+                n_vc->ne[0] == 3 * C && n_vc->ne[1] == n_seqs && n_vc->nb[0] == sizeof(float) &&
+                n_cpy->type == GGML_TYPE_F32 && n_cpy->nb[0] == sizeof(float)) {
+            out = { 3, store_pos + 2, n_cpy, n_cpy->nb[1] / sizeof(float), 0, 1 };
+            return true;
+        }
+        return false;
+    }
+    if (store_pos + 6 < cgraph->n_nodes && cgraph->nodes[store_pos + 6]->op == GGML_OP_SET_ROWS) {
+        ggml_tensor * n_vw = cgraph->nodes[store_pos + 0];
+        ggml_tensor * n_ar = cgraph->nodes[store_pos + 1];
+        ggml_tensor * n_sb = cgraph->nodes[store_pos + 2];
+        ggml_tensor * n_ci = cgraph->nodes[store_pos + 3];
+        ggml_tensor * n_vo = cgraph->nodes[store_pos + 4];
+        ggml_tensor * n_vs = cgraph->nodes[store_pos + 5];
+        ggml_tensor * n_st = cgraph->nodes[store_pos + 6];
+        if (n_vw->op != GGML_OP_VIEW || n_ar->op != GGML_OP_ARANGE || n_sb->op != GGML_OP_SCALE ||
+                n_ci->op != GGML_OP_CPY || n_vo->op != GGML_OP_VIEW || n_vs->op != GGML_OP_VIEW) {
+            return false;
+        }
+        for (int k = 0; k < 6; ++k) {
+            const ggml_tensor * nk = cgraph->nodes[store_pos + k];
+            const int uc = ggml_node_get_use_count(cgraph, store_pos + k);
+            const bool uc_ok = (uc == 1) || (k == 3 && nk->src[1] == nk && uc == 2);
+            if ((nk->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (nk->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 || !uc_ok) {
+                return false;
+            }
+        }
+        if ((n_st->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return false;
+        }
+        const int64_t K  = n_ar->ne[0];
+        const int64_t Kw = std::min(T, K);
+        if (K < 1 || Kw < 1 ||
+                ggml_get_op_params_f32(n_ar, 0) != 0.0f ||
+                ggml_get_op_params_f32(n_ar, 1) != (float) K ||
+                ggml_get_op_params_f32(n_ar, 2) != 1.0f ||
+                n_sb->src[0] != n_ar ||
+                ggml_get_op_params_f32(n_sb, 0) != -1.0f ||
+                ggml_get_op_params_f32(n_sb, 1) != (float) (K - 1) ||
+                n_ci->src[0] != n_sb || n_ci->type != GGML_TYPE_I32 ||
+                n_vo->src[0] != n_ci || n_vo->ne[0] != Kw || n_vo->view_offs != (size_t) (K - Kw) * sizeof(int32_t) ||
+                n_vw->src[0] != n_cat || n_vw->ne[0] != 3 || n_vw->ne[1] != Kw || n_vw->ne[2] != C || n_vw->ne[3] != n_seqs ||
+                n_vw->nb[1] != sizeof(float) || n_vw->view_offs != (size_t) (T - (Kw - 1)) * sizeof(float) ||
+                n_vs->ne[0] != 3 || n_vs->ne[1] != K || n_vs->ne[2] != C || n_vs->ne[3] != n_seqs ||
+                n_vs->type != GGML_TYPE_F32 || n_vs->nb[0] != sizeof(float) || n_vs->nb[2] != 3 * sizeof(float) ||
+                n_st->src[0] != n_vw || n_st->src[1] != n_vo || n_st->src[2] != n_vs ||
+                n_st->type != GGML_TYPE_F32 || n_st->nb[0] != sizeof(float) || n_st->nb[2] != 3 * sizeof(float)) {
+            return false;
+        }
+        out = { 7, store_pos + 6, n_st, n_st->nb[3] / sizeof(float), n_st->nb[1] / sizeof(float), (int) Kw };
+        return true;
+    }
+    return false;
+}
