+// Shared matcher for Wave 6A / 7A / 8 All-3-Input Mega-Horizontal Multi-GEMV (T = 1..16)
+static bool ggml_cuda_match_inkling_horiz_mmv_at(
+        const ggml_cgraph * cgraph,
+        const int start_idx,
+        const ggml_tensor * inputs[3],
+        int & n_inputs,
+        ggml_tensor * mats[8],
+        int in_idxs[8],
+        int & n_mats) {
+    if (start_idx + 1 >= cgraph->n_nodes ||
+            cgraph->nodes[start_idx]->op != GGML_OP_MUL_MAT ||
+            cgraph->nodes[start_idx + 1]->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * x0 = cgraph->nodes[start_idx]->src[1];
+    if (!x0 || x0->type != GGML_TYPE_F32 || !ggml_is_contiguous(x0) ||
+            x0->ne[1] < 1 || x0->ne[1] > 8 || x0->ne[2] != 1 || x0->ne[3] != 1 ||
+            (x0->ne[0] % QK8_0) != 0 || x0->ne[0] < 256) {
+        return false;
+    }
+    const int64_t K = x0->ne[0];
+    const int64_t T = x0->ne[1];
+    inputs[0] = x0; inputs[1] = nullptr; inputs[2] = nullptr;
+    n_inputs = 1;
+    n_mats = 0;
+    bool has_q8_0 = false;
+    for (int k = 0; k < 8 && start_idx + k < cgraph->n_nodes; ++k) {
+        ggml_tensor * m = cgraph->nodes[start_idx + k];
+        if (m->op != GGML_OP_MUL_MAT ||
+                (m->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+                m->type != GGML_TYPE_F32 || !ggml_is_contiguous(m) ||
+                ggml_get_op_params_i32(m, 1) != GGML_HINT_NONE) {
+            break;
+        }
+        const ggml_tensor * x = m->src[1];
+        if (!x || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) ||
+                x->ne[0] != K || x->ne[1] != T || x->ne[2] != 1 || x->ne[3] != 1) {
+            break;
+        }
+        int u = -1;
+        for (int j = 0; j < n_inputs; ++j) {
+            if (inputs[j] == x) {
+                u = j;
+                break;
+            }
+        }
+        if (u < 0) {
+            if (n_inputs >= 3) {
+                break;
+            }
+            u = n_inputs++;
+            inputs[u] = x;
+        }
+        const ggml_tensor * w = m->src[0];
+        if (!w || !ggml_is_contiguous(w) || w->ne[0] != K || w->ne[2] != 1 || w->ne[3] != 1 ||
+                (w->type != GGML_TYPE_Q8_0 && w->type != GGML_TYPE_BF16 && w->type != GGML_TYPE_F16 && w->type != GGML_TYPE_F32)) {
+            break;
+        }
+        if (w->type == GGML_TYPE_Q8_0) {
+            has_q8_0 = true;
+        }
+        mats[n_mats]      = m;
+        in_idxs[n_mats]   = u;
+        n_mats++;
+    }
+    if (n_mats < 2 || !has_q8_0) {
+        return false;
+    }
+    // Check that no two outputs overlap each other (inputs are pre-quantized / copied into pool before GEMV!)
+    auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const int64_t a0 = (int64_t) a->data;
+        const int64_t a1 = a0 + (int64_t) ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+        const int64_t b0 = (int64_t) b->data;
+        const int64_t b1 = b0 + (int64_t) ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+        return (b0 <= a0 && a0 < b1) || (a0 <= b0 && b0 < a1);
+    };
+    for (int a = 0; a < n_mats; ++a) {
+        for (int b = a + 1; b < n_mats; ++b) {
+            if (overlaps(mats[a], mats[b])) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
