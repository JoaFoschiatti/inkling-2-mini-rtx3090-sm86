+static void append_utf8_cp(std::string & out, uint32_t cp) {
+    if (cp < 0x80) {
+        out.push_back(static_cast<char>(cp));
+    } else if (cp < 0x800) {
+        out.push_back(static_cast<char>(0xC0 | (cp >> 6)));
+        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+    } else if (cp < 0x10000) {
+        out.push_back(static_cast<char>(0xE0 | (cp >> 12)));
+        out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+    } else if (cp < 0x110000) {
+        out.push_back(static_cast<char>(0xF0 | (cp >> 18)));
+        out.push_back(static_cast<char>(0x80 | ((cp >> 12) & 0x3F)));
+        out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
+        out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+    }
+}
+
+static bool is_ws_cp(uint32_t cp) {
+    return cp == ' ' || cp == '\n' || cp == '\t' || cp == '\r';
+}
+
+static bool char_class_is_only_ws(const llama_grammar_element * pos, bool & allows_space, bool & allows_nl) {
+    if (pos->type != LLAMA_GRETYPE_CHAR) {
+        return false;
+    }
+    const llama_grammar_element * p = pos;
+    do {
+        if (p[1].type == LLAMA_GRETYPE_CHAR_RNG_UPPER) {
+            for (uint32_t c = p->value; c <= p[1].value; ++c) {
+                if (!is_ws_cp(c)) {
+                    return false;
+                }
+                if (c == ' ')  allows_space = true;
+                if (c == '\n') allows_nl    = true;
+            }
+            p += 2;
+        } else {
+            if (!is_ws_cp(p->value)) {
+                return false;
+            }
+            if (p->value == ' ')  allows_space = true;
+            if (p->value == '\n') allows_nl    = true;
+            p += 1;
+        }
+    } while (p->type == LLAMA_GRETYPE_CHAR_ALT);
+    return true;
+}
+
+static bool is_single_char_elem(const llama_grammar_element * pos, uint32_t & out_cp) {
+    if (pos->type != LLAMA_GRETYPE_CHAR) {
+        return false;
+    }
+    if (pos[1].type == LLAMA_GRETYPE_CHAR_RNG_UPPER || pos[1].type == LLAMA_GRETYPE_CHAR_ALT) {
+        return false;
+    }
+    out_cp = pos->value;
+    return out_cp > 0;
+}
+
+static bool advance_stacks_by_cp(
+        const llama_grammar_rules & rules,
+        llama_grammar_stacks      & stacks,
+        uint32_t                    cp) {
+    llama_grammar_stacks next;
+    next.reserve(stacks.size());
+    for (const auto & stack : stacks) {
+        if (stack.empty()) {
+            continue;
+        }
+        const llama_grammar_element * pos = stack.back();
+        if (pos->type == LLAMA_GRETYPE_TOKEN || pos->type == LLAMA_GRETYPE_TOKEN_NOT) {
+            continue;
+        }
+        auto match = llama_grammar_match_char(pos, cp);
+        if (match.first) {
+            llama_grammar_stack ns(stack.begin(), stack.end() - 1);
+            if (!llama_grammar_is_end_of_sequence(match.second)) {
+                ns.push_back(match.second);
+            }
+            llama_grammar_advance_stack(rules, ns, next);
+        }
+    }
+    if (next.empty()) {
+        return false;
+    }
+    stacks = std::move(next);
+    return true;
+}
+
+static bool advance_stacks_by_token_elem(
+        const llama_grammar_rules & rules,
+        llama_grammar_stacks      & stacks,
+        llama_token                 tok) {
+    llama_grammar_stacks next;
+    next.reserve(stacks.size());
+    for (const auto & stack : stacks) {
+        if (stack.empty()) {
+            continue;
+        }
+        const llama_grammar_element * pos = stack.back();
+        if (pos->type == LLAMA_GRETYPE_TOKEN && static_cast<llama_token>(pos->value) == tok) {
+            llama_grammar_stack ns(stack.begin(), stack.end() - 1);
+            if (!llama_grammar_is_end_of_sequence(pos + 1)) {
+                ns.push_back(pos + 1);
+            }
+            llama_grammar_advance_stack(rules, ns, next);
+        }
+    }
+    if (next.empty()) {
+        return false;
+    }
+    stacks = std::move(next);
+    return true;
+}
+
+// Validate a candidate token against a mutable simulation state without aborting
+static bool try_accept_token_sim(
+        const llama_grammar_rules & rules,
+        const llama_vocab         & vocab,
+        llama_grammar_stacks      & stacks,
+        llama_partial_utf8        & partial,
+        llama_token                 tok) {
+    if (vocab.is_eog(tok)) {
+        return false;
+    }
+    const std::string & piece = vocab.token_to_piece(tok);
+    if (piece.empty() || piece[0] == 0) {
+        return false;
+    }
+    const auto decoded = decode_utf8(piece, partial);
+    if (decoded.second.n_remain < 0) {
+        return false;
+    }
+    const auto & cps = decoded.first;
+    llama_grammar_stacks next;
+    next.reserve(stacks.size());
+
+    // Check token-rule stacks first (same semantics as llama_grammar_accept_token)
+    for (const auto & stack : stacks) {
+        if (stack.empty()) {
+            continue;
+        }
+        const llama_grammar_element * pos = stack.back();
+        if (pos->type == LLAMA_GRETYPE_TOKEN || pos->type == LLAMA_GRETYPE_TOKEN_NOT) {
+            if (llama_grammar_match_token(pos, tok)) {
+                llama_grammar_stack ns(stack.begin(), stack.end() - 1);
+                if (!llama_grammar_is_end_of_sequence(pos + 1)) {
+                    ns.push_back(pos + 1);
+                }
+                llama_grammar_advance_stack(rules, ns, next);
+            }
+        }
+    }
+
+    // Check char-rule stacks across all code points in piece
+    llama_grammar_stacks char_stacks;
+    char_stacks.reserve(stacks.size());
+    for (const auto & stack : stacks) {
+        if (!stack.empty()) {
+            const llama_grammar_element * pos = stack.back();
+            if (pos->type != LLAMA_GRETYPE_TOKEN && pos->type != LLAMA_GRETYPE_TOKEN_NOT) {
+                char_stacks.push_back(stack);
+            }
+        }
+    }
+    for (size_t k = 0; k + 1 < cps.size() && !char_stacks.empty(); ++k) {
+        if (!advance_stacks_by_cp(rules, char_stacks, cps[k])) {
+            char_stacks.clear();
+            break;
+        }
+    }
+    if (decoded.second.n_remain > 0 && !char_stacks.empty()) {
+        llama_grammar_stacks filtered;
+        for (const auto & st : char_stacks) {
+            if (!st.empty()) {
+                const auto * pos = st.back();
+                if (pos->type != LLAMA_GRETYPE_TOKEN && pos->type != LLAMA_GRETYPE_TOKEN_NOT &&
+                        llama_grammar_match_partial_char(pos, decoded.second)) {
+                    filtered.push_back(st);
+                }
+            }
+        }
+        char_stacks = std::move(filtered);
+    }
+
+    for (auto & st : char_stacks) {
+        if (std::find(next.begin(), next.end(), st) == next.end()) {
+            next.push_back(std::move(st));
+        }
+    }
+    if (next.empty()) {
+        return false;
+    }
+    stacks  = std::move(next);
+    partial = decoded.second;
+    return true;
+}
+
+int32_t llama_grammar_draft_forced_prefix_impl(
+        const struct llama_grammar & grammar,
+                       llama_token * out_tokens,
+                           int32_t   max_tokens,
+                              bool   space_after_punct) {
+    if (grammar.awaiting_trigger || grammar.stacks.empty() || grammar.vocab == nullptr ||
+            grammar.partial_utf8.n_remain != 0 || max_tokens <= 0 || out_tokens == nullptr) {
+        return 0;
+    }
+
+    const llama_grammar_rules & rules = *grammar.rules;
+    const llama_vocab         & vocab = *grammar.vocab;
+
+    llama_grammar_stacks stacks = grammar.stacks;
+    llama_grammar_stacks sim_stacks = grammar.stacks;
+    llama_partial_utf8   sim_partial = grammar.partial_utf8;
+
+    int32_t n_out = 0;
+    constexpr int MAX_CHARS = 96;
+
+    while (n_out < max_tokens && !stacks.empty()) {
+        // 1) Check for strictly forced single token rule (LLAMA_GRETYPE_TOKEN)
+        bool all_same_tok = true;
+        llama_token forced_tok = LLAMA_TOKEN_NULL;
+        for (const auto & stack : stacks) {
+            if (stack.empty()) {
+                all_same_tok = false;
+                break;
+            }
+            const llama_grammar_element * pos = stack.back();
+            if (pos->type != LLAMA_GRETYPE_TOKEN) {
+                all_same_tok = false;
+                break;
+            }
+            const llama_token t = static_cast<llama_token>(pos->value);
+            if (forced_tok == LLAMA_TOKEN_NULL) {
+                forced_tok = t;
+            } else if (forced_tok != t) {
+                all_same_tok = false;
+                break;
+            }
+        }
+        if (all_same_tok && forced_tok != LLAMA_TOKEN_NULL) {
+            if (!try_accept_token_sim(rules, vocab, sim_stacks, sim_partial, forced_tok)) {
+                break;
+            }
+            out_tokens[n_out++] = forced_tok;
+            if (!advance_stacks_by_token_elem(rules, stacks, forced_tok)) {
+                break;
+            }
+            continue;
+        }
+
+        // 2) Extract forced literal character sequence (with smart optional-whitespace handling for JSON/tool calls)
+        // space_after_punct is overloaded via ws_mode encoded in out_tokens[0] sentinel? No — clean bool + nl support:
+        // When ws_nl (pretty-print) is detected via out_tokens[0] == -2 (passed by common_sampler_grammar_draft_prefix),
+        // emit "\n  " after '{' and ',' and "\n" before '}'.
+        const bool strict_no_ws = (max_tokens > 0 && out_tokens[0] == -3);
+        const bool pretty_nl    = (max_tokens > 0 && out_tokens[0] == -2);
+        std::string lit;
+        lit.reserve(MAX_CHARS);
+        int ws_skips = 0;
+
+        for (int step = 0; step < MAX_CHARS && !stacks.empty(); ++step) {
+            bool ok = true;
+            uint32_t lit_cp = 0;
+            bool has_lit = false;
+            bool has_ws  = false;
+            bool ws_allows_space = false;
+            bool ws_allows_nl    = false;
+
+            for (const auto & stack : stacks) {
+                if (stack.empty()) {
+                    ok = false; // EOG allowed -> do not speculate past end
+                    break;
+                }
+                const llama_grammar_element * pos = stack.back();
+                uint32_t cp = 0;
+                if (is_single_char_elem(pos, cp)) {
+                    if (is_ws_cp(cp)) {
+                        has_ws = true;
+                        if (cp == ' ')  ws_allows_space = true;
+                        if (cp == '\n') ws_allows_nl    = true;
+                    } else if (!has_lit) {
+                        lit_cp  = cp;
+                        has_lit = true;
+                    } else if (lit_cp != cp) {
+                        ok = false;
+                        break;
+                    }
+                } else if (char_class_is_only_ws(pos, ws_allows_space, ws_allows_nl)) {
+                    has_ws = true;
+                } else {
+                    ok = false;
+                    break;
+                }
+            }
+
+            if (!ok) {
+                break;
+            }
+
+            uint32_t chosen = 0;
+            if (has_lit && !has_ws) {
+                // 100% strictly forced character
+                chosen = lit_cp;
+            } else if (!has_lit && has_ws && ws_allows_space) {
+                // Check if strictly forced single space (e.g. " ")
+                bool all_space = true;
+                for (const auto & stack : stacks) {
+                    uint32_t cp = 0;
+                    if (!is_single_char_elem(stack.back(), cp) || cp != ' ') {
+                        all_space = false;
+                        break;
+                    }
+                }
+                if (all_space) {
+                    chosen = ' ';
+                } else {
+                    break;
+                }
+            } else if (!strict_no_ws && has_lit && has_ws && ws_skips < 8) {
+                const bool after_colon = !lit.empty() && lit.back() == ':';
+                const bool after_comma = !lit.empty() && lit.back() == ',';
+                const bool after_brace = !lit.empty() && lit.back() == '{';
+                if (pretty_nl && (after_comma || after_brace) && ws_allows_nl) {
+                    // Pretty-printed JSON: emit "\n  " after ',' or '{'
+                    if (advance_stacks_by_cp(rules, stacks, '\n')) {
+                        lit.push_back('\n');
+                        if (advance_stacks_by_cp(rules, stacks, ' ')) {
+                            lit.push_back(' ');
+                            if (advance_stacks_by_cp(rules, stacks, ' ')) {
+                                lit.push_back(' ');
+                            }
+                        }
+                        ws_skips++;
+                        continue;
+                    }
+                    break;
+                } else if (pretty_nl && lit_cp == '}' && ws_allows_nl && (lit.empty() || lit.back() != '\n')) {
+                    chosen = '\n';
+                } else if ((after_colon || (after_comma && !pretty_nl)) && space_after_punct && ws_allows_space) {
+                    chosen = ' ';
+                } else if (lit_cp == ':' || lit_cp == ',' || lit_cp == '}' || lit_cp == ']' || lit_cp == '"' || lit_cp == '{' || lit_cp == '[') {
+                    chosen = lit_cp;
+                } else {
+                    break;
+                }
+                ws_skips++;
+            } else {
+                break;
+            }
+
+            if (!advance_stacks_by_cp(rules, stacks, chosen)) {
+                break;
+            }
+            append_utf8_cp(lit, chosen);
+        }
+
+        if (lit.empty()) {
+            break;
+        }
+
+        // Tokenize forced literal with exact model BPE and verify every token against sim_stacks!
+        const std::vector<llama_token> toks = vocab.tokenize(lit, /*add_special=*/false, /*parse_special=*/false);
+        if (toks.empty()) {
+            break;
+        }
+        int32_t added = 0;
+        for (llama_token tok : toks) {
+            if (n_out >= max_tokens) {
+                break;
+            }
+            if (!try_accept_token_sim(rules, vocab, sim_stacks, sim_partial, tok)) {
+                break;
+            }
+            out_tokens[n_out++] = tok;
+            added++;
+        }
+        if (added == 0 || (size_t) added < toks.size()) {
+            break;
+        }
+        // Keep stacks synced with sim_stacks in case a forced token rule follows lit!
+        stacks = sim_stacks;
+    }
+
+    return n_out;
+}
