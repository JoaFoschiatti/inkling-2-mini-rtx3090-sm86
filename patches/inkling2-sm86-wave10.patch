+// Dedicated 1-warp-per-row no-sync kernel for small/medium-K NVFP4 MoE (K<=4096: gate_up_exps & down_exps on SM 8.6).
+// 8 independent warps per block, 0 barriers, 0 shared memory -> ~690-745 GB/s on RTX 3090.
+template <bool has_fusion>
+__launch_bounds__(256, 1)
+static __global__ void mul_mat_vec_q_nvfp4_nosync_1(
+        const void * __restrict__ vx,
+        const void * __restrict__ vy,
+        const int32_t * __restrict__ ids,
+        const ggml_cuda_mm_fusion_args_device fusion,
+        float * __restrict__ dst,
+        const uint32_t ncols_x,
+        const uint3 nchannels_y,
+        const uint32_t nrows_x,
+        const uint32_t stride_row_x,
+        const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y,
+        const uint32_t stride_channel_dst) {
+    constexpr int qk  = ggml_cuda_type_traits<GGML_TYPE_NVFP4>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<GGML_TYPE_NVFP4>::qi;
+    constexpr int vdr = VDR_NVFP4_Q8_1_MMVQ;
+    constexpr int warp_size = 32;
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+
+    const uint32_t row = blockIdx.x * 8 + threadIdx.y;
+    if (row >= nrows_x) {
+        return;
+    }
+
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t channel_x   = ids[channel_dst];
+    const uint32_t channel_y   = fastmodulo(channel_dst, nchannels_y);
+
+    const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y * stride_channel_y;
+    const int kbx_offset = channel_x * stride_channel_x + row * stride_row_x;
+    const int blocks_per_row_x = ncols_x / qk;
+
+    float sum = 0.0f;
+    for (int kbx = threadIdx.x / (qi / vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk / QK8_1);
+        const int kqs = vdr * (threadIdx.x % (qi / vdr));
+        sum += vec_dot_nvfp4_q8_1(vx, &y[kby], kbx_offset + kbx, kqs);
+    }
+
+    sum = warp_reduce_sum<warp_size>(sum);
+
+    if (threadIdx.x == 0) {
+        if constexpr (has_fusion) {
+            if (fusion.x_scale) {
+                sum *= ((const float *) fusion.x_scale)[channel_x];
+            }
+            if (fusion.x_bias) {
+                sum += ((const float *) fusion.x_bias)[channel_x * stride_channel_dst + row];
+            }
+        }
+        dst[channel_dst * stride_channel_dst + row] = sum;
+    }
+}
