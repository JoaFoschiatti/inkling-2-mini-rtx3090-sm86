+// Dedicated 1-warp-per-row no-sync Q8_0 kernel for large-N projections (e.g. lm_head 201024x2304 on SM 8.6: ~7% faster than 4w/row!).
+template <int NB_FIXED>
+__launch_bounds__(256, 1)
+static __global__ void mul_mat_vec_q_q8_0_nosync_1(
+        const block_q8_0 * __restrict__ vx,
+        const block_q8_1 * __restrict__ vy,
+        float * __restrict__ dst,
+        const uint32_t nrows_x,
+        const uint32_t stride_row_x) {
+    const uint32_t row = blockIdx.x * 8 + threadIdx.y;
+    if (row >= nrows_x) {
+        return;
+    }
+    const int tid = threadIdx.x;
+    const block_q8_0 * xrow = vx + (size_t) row * stride_row_x;
+    const int iqs = (tid & 3) * 2;
+    float sum = 0.0f;
+#pragma unroll
+    for (int k = tid >> 2; k < NB_FIXED; k += 8) {
+        const block_q8_0 * bx = &xrow[k];
+        const block_q8_1 * by = &vy[k];
+        const uint16_t * x16 = (const uint16_t *) bx->qs;
+        const int v0 = (int) __ldg(&x16[2 * (iqs + 0) + 0]) | ((int) __ldg(&x16[2 * (iqs + 0) + 1]) << 16);
+        const int v1 = (int) __ldg(&x16[2 * (iqs + 1) + 0]) | ((int) __ldg(&x16[2 * (iqs + 1) + 1]) << 16);
+        const int * uy = (const int *) by->qs;
+        int s = ggml_cuda_dp4a(v0, __ldg(uy + iqs + 0), 0);
+        s     = ggml_cuda_dp4a(v1, __ldg(uy + iqs + 1), s);
+        sum += (float) s * __half2float(__ldg(&bx->d)) * __low2float(by->ds);
+    }
+    sum = warp_reduce_sum<32>(sum);
+    if (tid == 0) {
+        dst[row] = sum;
+    }
+}
